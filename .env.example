# Everything is optional: the site runs on the free ESPN feed with no keys at all.

# --- AI analyst (full + live match analysis, AI check on the coupon du jour) ---
# Get a key at https://platform.claude.com
ANTHROPIC_API_KEY=your_anthropic_api_key
# Engine model. Default claude-opus-5-5; claude-sonnet-5-5 is cheaper.
ENGINE_MODEL=claude-opus-5-5
# true lets the analyst web-search injuries and lineups first (slower, more tokens)
ENGINE_WEB_SEARCH=false
# false turns off the AI review of the coupon du jour
COUPON_AI=true

# --- Bookmaker comparison (1xBet, Pinnacle, Bet365 …) on the match page ---
# Free key at https://the-odds-api.com (500 credits/month on the free plan)
ODDS_API_KEY=your_odds_api_key
ODDS_REGIONS=eu
ODDS_BOOKMAKERS=onexbet,pinnacle,bet365,unibet_eu,williamhill,betclic
# Minutes to cache bookmaker prices (protects your credits)
ODDS_CACHE_MIN=30

# --- Accounts (sign in / sign up) — Supabase project → Settings → API ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
