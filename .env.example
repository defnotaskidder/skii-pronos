# Get a free key at https://the-odds-api.com (500 credits/month on the free plan)
ODDS_API_KEY=your_odds_api_key
# Bookmaker regions to query (comma separated). eu includes 1xBet when it is listed.
ODDS_REGIONS=eu
# Preferred bookmakers, first one found is used. Others are fallbacks.
ODDS_BOOKMAKERS=onexbet,pinnacle,bet365,unibet_eu,williamhill,betclic

# Get a key at https://platform.claude.com
ANTHROPIC_API_KEY=your_anthropic_api_key
# Engine model. claude-sonnet-5 is the cost-effective default; claude-opus-5 is stronger and pricier.
ENGINE_MODEL=claude-sonnet-5
# Set to true to let the engine web-search form and injuries (slower, more tokens)
ENGINE_WEB_SEARCH=false
