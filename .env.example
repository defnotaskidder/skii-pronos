# Everything is optional: the site runs on the free ESPN feed with no keys at all.
# On Vercel, set these under Project → Settings → Environment Variables, then redeploy.

# --- AI analyst (full + live match analysis, AI check on the daily coupons) ---
ANTHROPIC_API_KEY=your_anthropic_api_key
ENGINE_MODEL=claude-opus-5-5
ENGINE_WEB_SEARCH=false
COUPON_AI=true

# --- Bookmaker comparison (1xBet, Pinnacle, Bet365 …) on the match page — The Odds API ---
ODDS_API_KEY=your_odds_api_key
# optional backup keys, comma-separated; used when the main key runs out of credits
ODDS_API_KEYS=
ODDS_REGIONS=eu
ODDS_BOOKMAKERS=onexbet,pinnacle,bet365,unibet_eu,williamhill,betclic
ODDS_CACHE_MIN=30
# Hockey leagues ESPN lacks (SHL, HockeyAllsvenskan, Liiga, Mestis, AHL…) load from The Odds API with the
# same key: fixtures + prices every ODDS_HOCKEY_MIN minutes (default = ODDS_CACHE_MIN; 1 credit per market
# per league per refresh), results every ODDS_SCORES_MIN minutes only while a game awaits its final score
# (2 credits). Five leagues in season at the defaults ≈ 500 credits a day: on the free plan
# (500/month) keep one league at ODDS_HOCKEY_MIN=360, ODDS_SCORES_MIN=60.
ODDS_HOCKEY_MIN=
ODDS_SCORES_MIN=15
# results sweep when no game is pending (finished games feed the team ratings)
ODDS_SWEEP_MIN=360
ODDS_HOCKEY_MARKETS=h2h,totals
# restrict to some league ids from lib/leagues.js, e.g. shl,liiga (empty = every league in season)
ODDS_HOCKEY_LEAGUES=
# credits never spent on these leagues (kept for the bookmaker comparison panel)
ODDS_RESERVE=100
# Sharper base prices from Pinnacle for the top leagues (costs credits: ~2 per league per refresh)
ODDS_SHARP=false
ODDS_SHARP_MIN=240
ODDS_SHARP_LEAGUES=

# --- Accounts + history + alerts: connect Supabase in Vercel (Storage → Supabase). ---
# The integration sets POSTGRES_URL, SUPABASE_URL and SUPABASE_ANON_KEY (any prefix works).

# --- Telegram bot (create one with @BotFather) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
# Channel or group the daily coupons are posted to (the bot must be an admin), e.g. @skiipronos
TELEGRAM_CHANNEL=

# --- WhatsApp (Meta Cloud API: developers.facebook.com → WhatsApp) ---
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_NUMBER=
WHATSAPP_VERIFY_TOKEN=
# Approved template name for messages sent outside the 24-hour window (one {{1}} text parameter)
WHATSAPP_TEMPLATE=

# --- Posting & alerts ---
SITE_URL=https://skii-pronos.vercel.app
SITE_TZ=Africa/Abidjan
POST_HOUR=8
RESULTS_HOUR=23
# Optional: protects /api/cron and /api/tick (otherwise the tick secret stored in the database is used)
CRON_SECRET=
TICK_SECRET=
VAPID_SUBJECT=mailto:you@example.com

# --- Home page cards (optional; each card only shows once its value is set) ---
# WhatsApp channel link for the "Join the free WhatsApp channel" card (without it: an alerts card)
NEXT_PUBLIC_WHATSAPP_CHANNEL=
# 1xBet promo code and sign-up link for the "Bonus code" box
NEXT_PUBLIC_BONUS_CODE=
NEXT_PUBLIC_BONUS_URL=
